{
  "name": "discoverex-core",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh"
}
