      "bootstrap_mode": "auto",
      "extras": [
        "tracking",
        "storage"
      ],
      "extra_env": {
        "MLFLOW_TRACKING_URI": "https://mlflow.discoverex.qzz.io",
        "AWS_ACCESS_KEY_ID": "discoverex-admin-key",
