{
  "run_mode": "repo",
  "engine": "discoverex",
  "repo_url": "https://github.com/discoverex/engine.git",
  "ref": "feat/engine-run-wrapper-contract",
  "entrypoint": [
    "/bin/sh",
    "-lc",
    "PYTHONPATH=src python -m discoverex.orchestrator_contract.launcher"
  ],
  "config": null,
  "job_name": "generate--generate--generator-sdxl-gpu",
  "engine_run": {
    "contract_version": "v2",
    "command": "generate",
    "config_name": "generate",
